{
  "name": "calculadora-vantagens-sicoob-imobvc",
  "private": true,
  "version": "1.0.4",
  "description": "Calculadora de Vantagens — Sicoob Imob.vc (desktop)",
  "author": "Kaio Gomes",
  "license": "MIT",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "electron:dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && cross-env ELECTRON_DEV=1 electron .\"",
    "start": "npm run build && electron .",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "dist": "npm run build && electron-builder --config electron-builder.config.cjs --win --publish never",
    "versao:patch": "npm version patch --no-git-tag-version",
    "versao:minor": "npm version minor --no-git-tag-version",
    "publicar": "node scripts/release.cjs patch",
    "publicar:minor": "node scripts/release.cjs minor"
  },
  "dependencies": {
    "decimal.js": "10.6.0",
    "electron-updater": "6.8.11",
    "lucide-react": "1.64.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "concurrently": "10.0.6",
    "cross-env": "10.1.0",
    "electron": "45.1.0",
    "electron-builder": "26.18.0",
    "eslint": "9.39.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "wait-on": "9.5.1"
  }
}
